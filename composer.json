{
    "name": "coinspay/coinspay-php",
    "description": "Official PHP library for the CoinsPay crypto payments API",
    "type": "library",
    "license": "MIT",
    "keywords": ["coinspay", "crypto", "payments", "invoices", "webhooks", "usdt", "bitcoin"],
    "require": {
        "php": ">=7.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5 || ^9.6 || ^11.5",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "CoinsPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoinsPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
