<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal on purpose: one file for PHPUnit 6.5, 9.6 and 11.5. -->
<phpunit bootstrap="tests/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
